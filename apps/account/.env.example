# =====================================================================
# JDC Account (Identity Provider) — salin ke apps/account/.env
# =====================================================================
APP_ENV=production
# URL dasar domain TANPA slash akhir. Issuer OIDC = APP_URL/account
APP_URL=https://jdc.shfopis.com
# true di produksi (HTTPS). false hanya untuk pengembangan lokal via http://
COOKIE_SECURE=true
# Pepper HMAC untuk OTP & token reset. Buat: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_KEY=
# IP reverse proxy/CDN tepercaya (pisahkan koma), kosongkan bila tidak ada
PROXY_IPS=

DB_DRIVER=mysqli
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jdc_account
DB_PASSWORD=
DB_NAME=jdc_account

REDIS_TRANSPORT=tcp
REDIS_SCHEME=tcp
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Prefix key WAJIB unik per layanan bila Redis dipakai bersama
REDIS_PREFIX=idp:

# Direktori kunci RS256 — sebaiknya DI LUAR public_html, mis. /home/user/jdc-keys/
OIDC_KEYS_DIR=

# Secret client OAuth (min. 32 karakter). Buat: php account.php cli/clients secret
# Nilai yang SAMA harus diisi di .env layanan terkait.
CLIENT_KOPERASI_SECRET=
CLIENT_MARKET_SECRET=
CLIENT_MARKET_SERVER_SECRET=

IDP_SESSION_IDLE_TTL=7200
IDP_SESSION_ABSOLUTE_TTL=43200
IDP_SESSION_REMEMBER_TTL=2592000
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
OTP_TTL_SECONDS=900

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@jdc.shfopis.com

# Hanya untuk `php account.php cli/users migrate` — default: DB koperasi_digital di server yang sama
MIGRATE_SOURCE_DB_HOST=
MIGRATE_SOURCE_DB_USER=
MIGRATE_SOURCE_DB_PASSWORD=
MIGRATE_SOURCE_DB_NAME=koperasi_digital
