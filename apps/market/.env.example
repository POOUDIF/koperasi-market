# =====================================================================
# Marketplace JDC — salin ke apps/market/.env
# =====================================================================
APP_ENV=production
APP_URL=https://jdc.shfopis.com
COOKIE_SECURE=true
PROXY_IPS=

# --- SSO (client "market" di JDC Account) ---
SSO_ISSUER=https://jdc.shfopis.com/account
SSO_CLIENT_ID=market
# Sama dengan CLIENT_MARKET_SECRET di apps/account/.env
SSO_CLIENT_SECRET=
# 32 byte base64: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
SESSION_ENC_KEY=
SESSION_IDLE_TTL=604800
SESSION_ABSOLUTE_TTL=2592000

# --- Identitas server ke API internal koperasi (client_credentials) ---
SERVICE_CLIENT_ID=market-server
# Sama dengan CLIENT_MARKET_SERVER_SECRET di apps/account/.env
SERVICE_CLIENT_SECRET=
KOPERASI_INTERNAL_BASE=https://jdc.shfopis.com/koperasi/api/v1/internal
# Sama dengan MARKET_WEBHOOK_SECRET di .env koperasi
KOPERASI_WEBHOOK_SECRET=

DB_DRIVER=mysqli
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jdc_market
DB_PASSWORD=
DB_NAME=jdc_market

REDIS_TRANSPORT=tcp
REDIS_SCHEME=tcp
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=mkt:
