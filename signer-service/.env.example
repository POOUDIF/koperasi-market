# Signer service — proses TERPISAH dari aplikasi CI3, dengan .env sendiri.
# JANGAN pernah menaruh file ini (atau .env hasil isiannya) di dalam repo
# koperasi-market, dan JANGAN pernah membaca OWNER_PRIVATE_KEY dari proses
# PHP-FPM/php -S — itulah alasan signer ini dipisah (§16.4 blueprint).

PORT=3100

# RPC node Polygon (mis. Alchemy/Infura/QuickNode).
POLYGON_RPC_URL=

# Private key wallet yang punya izin mint di kontrak CoopGold.
# KUNCI INI BISA MENCETAK TOKEN TANPA BATAS. Simpan di secret manager saat
# produksi (mis. AWS Secrets Manager/Vault), jangan pernah commit ke git.
OWNER_PRIVATE_KEY=

# Alamat kontrak CoopGold yang sudah di-deploy.
GOLD_CONTRACT_ADDRESS=
