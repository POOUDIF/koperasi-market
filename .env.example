# =====================================================================
# Koperasi Digital (application/) — salin ke .env di root repo
# =====================================================================
APP_ENV=production
APP_URL=https://jdc.shfopis.com
COOKIE_SECURE=true

# legacy = Bearer JWT lama | both = transisi | sso = hanya login JDC Account
AUTH_MODE=sso

# --- SSO (client "koperasi" di JDC Account) ---
SSO_ISSUER=https://jdc.shfopis.com/account
SSO_CLIENT_ID=koperasi
# Sama dengan CLIENT_KOPERASI_SECRET di apps/account/.env
SSO_CLIENT_SECRET=
# 32 byte base64: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
SESSION_ENC_KEY=
SESSION_IDLE_TTL=1800
SESSION_ABSOLUTE_TTL=28800

# --- Jalur lama (AUTH_MODE legacy/both saja) ---
JWT_SECRET=
JWT_TOKEN_TTL_HOURS=24

DB_DRIVER=mysqli
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=koperasi_digital

REDIS_TRANSPORT=tcp
REDIS_SCHEME=tcp
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Koperasi sengaja tanpa prefix agar key lama (antrean emas, cache harga) tetap.
REDIS_PREFIX=

# Hanya untuk pengembangan frontend terpisah origin (vite dev server)
FRONTEND_URL=http://localhost:5173

# --- Koperasi Pay (§4) ---
MARKET_WEBHOOK_URL=https://jdc.shfopis.com/market/api/v1/webhooks/koperasi
# Sama dengan KOPERASI_WEBHOOK_SECRET di apps/market/.env (min. 32 karakter)
MARKET_WEBHOOK_SECRET=
PAYMENT_MAX_AMOUNT=50000000

MURABAHAH_MARGIN_RATE=0.10
GOLD_MAX_GRAM_PER_TX=100
GOLD_PRICE_CACHE_TTL=900
OTP_TTL_SECONDS=900

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@jdc.shfopis.com

# Signer service terpisah (Fase 6, §16.4 Opsi 2) — lihat signer-service/.env.example.
# OWNER_PRIVATE_KEY SENGAJA TIDAK ADA di sini: kunci penanda tangan hanya boleh
# hidup di proses signer, bukan di proses yang melayani HTTP (PHP-FPM/php -S).
SIGNER_SERVICE_URL=
GOLD_CONTRACT_ADDRESS=
